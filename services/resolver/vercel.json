{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/shunshou.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=Shunshou.shortcut; filename*=UTF-8''%E9%A1%BA%E6%89%8B.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/shunshou-check.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=Shunshou.shortcut; filename*=UTF-8''%E9%A1%BA%E6%89%8B.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
