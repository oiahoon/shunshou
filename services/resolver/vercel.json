{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "app.py": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/shortcuts/national-avatar", "destination": "/shortcuts/avatar-studio", "permanent": true }
  ],
  "rewrites": [
    { "source": "/shortcuts/insta-share", "destination": "/insta-share.html" },
    { "source": "/shortcuts/dianping", "destination": "/dianping.html" },
    { "source": "/shortcuts/business-trip", "destination": "/business-trip.html" },
    { "source": "/shortcuts/avatar-studio", "destination": "/avatar-studio.html" }
  ],
  "headers": [
    {
      "source": "/shunshou.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=Shunshou.shortcut; filename*=UTF-8''%E9%A1%BA%E6%89%8B.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/shunshou-check.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=Shunshou.shortcut; filename*=UTF-8''%E9%A1%BA%E6%89%8B.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/dianping.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=Dianping.shortcut; filename*=UTF-8''%E5%A4%A7%E4%BC%97%E7%82%B9%E8%AF%84%E5%BF%AB%E5%86%99.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/business-trip.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=BusinessTrip.shortcut; filename*=UTF-8''%E5%87%BA%E5%B7%AE%E5%BC%80%E9%94%80.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/national-avatar.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=AvatarStudio.shortcut; filename*=UTF-8''%E5%A4%B4%E5%83%8F%E8%A3%85%E6%89%AE.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/avatar-studio.shortcut",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=AvatarStudio.shortcut; filename*=UTF-8''%E5%A4%B4%E5%83%8F%E8%A3%85%E6%89%AE.shortcut" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
